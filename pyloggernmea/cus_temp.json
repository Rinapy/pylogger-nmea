{
    "$GNGGA": {
        "keys": [
            "time",
            "latitude",
            "longitude",
            "fix_quality",
            "horizontal_dilution"
        ],
        "indexes": [
            "1~truncate/0/|slice/2/|join/:/|~",
            2,
            4,
            6, 
            8
        ],
        "out_msg_template": "\n{time} {'n' if latitude == '' else latitude} {'n' if longitude == '' else longitude} {'n' if horizontal_dilution == '' else horizontal_dilution} "
    },
    "$GNRMC": {
        "keys": [
            "speed"
        ],
        "indexes": [
            7 
        ],
        "out_msg_template": "{'n' if speed == '' else speed}"
    },
    "$GNGSA": {
        "keys": [
            "satellites"
        ],
        "indexes": [
            "3:14"

        ],
        "out_msg_template": "{_check_satellites(satellites)} "
    }
}
